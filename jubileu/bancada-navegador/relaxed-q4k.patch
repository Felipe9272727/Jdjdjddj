diff --git a/ggml/src/ggml-cpu/arch/wasm/quants.c b/ggml/src/ggml-cpu/arch/wasm/quants.c
index 0a7119b..8dadf83 100644
--- a/ggml/src/ggml-cpu/arch/wasm/quants.c
+++ b/ggml/src/ggml-cpu/arch/wasm/quants.c
@@ -986,6 +986,30 @@ void ggml_vec_dot_q4_K_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const voi
             q8 += 64;
 
             // Low nibble products
+#if defined(__wasm_relaxed_simd__)
+            // ── A ORDEM DOS OPERANDOS E' A CORRECAO ─────────────────────
+            //
+            // `relaxed_dot_i8x16_i7x16_add(a, b, c)` so' da' o mesmo resultado
+            // em toda engine se `b` couber em i7, [0,127]: o x86 baixa para
+            // PMADDUBSW, que le' `b` como SEM SINAL, e o ARM para SDOT, que le'
+            // com sinal. Iguais so' enquanto b >= 0.
+            //
+            // A PR #19590 escreveu `(q4l0, q8x0)` -- as ATIVACOES na vaga i7.
+            // Elas sao int8 de faixa cheia (-128..127), entao em x86 o
+            // resultado vira lixo (medido: o modelo cospe "jumbotron pymysql").
+            //
+            // Aqui vai invertido: `(q8x0, q4l0)`. Os pesos sao nibbles
+            // `q4x0 & 0x0F` e `q4x0 >> 4`, ou seja 0..15 -- dentro de i7 por
+            // construcao. O produto escalar e' simetrico, entao a matematica
+            // nao muda; so' o valor pequeno passa a ocupar a vaga que exige
+            // valor pequeno.
+            //
+            // O agrupamento de faixas difere entre as duas instrucoes, e aqui
+            // isso e' inocuo: `vacc1` e' somado nas quatro faixas logo abaixo,
+            // e soma nao se importa com a ordem das parcelas.
+            v128_t vacc1 = wasm_i32x4_relaxed_dot_i8x16_i7x16_add(q8x0, q4l0, wasm_i32x4_splat(0));
+            vacc1 = wasm_i32x4_relaxed_dot_i8x16_i7x16_add(q8x1, q4l1, vacc1);
+#else
             v128_t vacc1 = wasm_i32x4_dot_i16x8(
                 wasm_i16x8_extend_low_i8x16(q4l0),
                 wasm_i16x8_extend_low_i8x16(q8x0)
@@ -1002,8 +1026,14 @@ void ggml_vec_dot_q4_K_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const voi
                 wasm_i16x8_extend_high_i8x16(q4l1),
                 wasm_i16x8_extend_high_i8x16(q8x1)
             ));
+#endif
 
             // High nibble products
+#if defined(__wasm_relaxed_simd__)
+            // Mesma inversao, mesmos motivos: q4h* sao `>> 4`, tambem 0..15.
+            v128_t vacc2 = wasm_i32x4_relaxed_dot_i8x16_i7x16_add(q8x2, q4h0, wasm_i32x4_splat(0));
+            vacc2 = wasm_i32x4_relaxed_dot_i8x16_i7x16_add(q8x3, q4h1, vacc2);
+#else
             v128_t vacc2 = wasm_i32x4_dot_i16x8(
                 wasm_i16x8_extend_low_i8x16(q4h0),
                 wasm_i16x8_extend_low_i8x16(q8x2)
@@ -1020,6 +1050,7 @@ void ggml_vec_dot_q4_K_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const voi
                 wasm_i16x8_extend_high_i8x16(q4h1),
                 wasm_i16x8_extend_high_i8x16(q8x3)
             ));
+#endif
 
             // Accumulate scaled results
             int32_t vacc1_sum = wasm_i32x4_extract_lane(vacc1, 0) + wasm_i32x4_extract_lane(vacc1, 1) +
